---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConnectCTA from '../components/ConnectCTA.astro';
import { getCollection } from 'astro:content';
import { SITE, absUrl } from '../data/site';

const learn = (await getCollection('learn')).sort(
  (a, b) => a.data.order - b.data.order,
);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.lang,
  publisher: { '@type': 'Organization', name: 'CrankingAI', url: SITE.url },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Model Context Protocol server',
  operatingSystem: 'Any (MCP host; Streamable HTTP or stdio)',
  description: SITE.description,
  url: SITE.url,
  downloadUrl: 'https://pypi.org/project/mcp-glimpse/',
  softwareHelp: absUrl('/learn'),
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'CrankingAI', url: SITE.url },
  featureList: [
    'Introspect an agent context across all connected MCP servers',
    'Annotation coverage and shadow-write detection',
    'Context-window token-cost accounting',
    'Capability negotiation and protocol version reporting',
    'Self-contained MCP App (ui://) view',
  ],
};

// Capability matrix rows — the MCP primitive coverage, kept honest about what
// requires a stateful session.
const capabilities: { name: string; who: string; glimpse: string; note: string }[] = [
  { name: 'Tools', who: 'server', glimpse: 'yes', note: 'introspect_mcp_context, submit_feedback' },
  { name: 'Prompts', who: 'server', glimpse: 'yes', note: 'Guided introspection prompts' },
  { name: 'Resources', who: 'server', glimpse: 'yes', note: 'glimpse:// reference library' },
  { name: 'Elicitation', who: 'client', glimpse: 'yes', note: 'Confirms feedback before writing' },
  { name: 'Sampling', who: 'client', glimpse: 'yes', note: 'Narrates your context in prose' },
  { name: 'Roots', who: 'client', glimpse: 'yes', note: 'Reads advertised workspace roots' },
  { name: 'Logging / progress', who: 'server', glimpse: 'yes', note: 'Emitted during analysis' },
  { name: 'Completions', who: 'server', glimpse: 'yes', note: 'Argument completion for prompts' },
];
---
<BaseLayout
  title={SITE.title}
  description={SITE.description}
  path="/"
  jsonld={[websiteSchema, softwareSchema]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Open-source MCP server · Python · MIT</p>
      <h1 class="hero-title">Point your agent<br />at itself.</h1>
      <p class="lede hero-lede">
        <strong>mcp-glimpse</strong> is an MCP server that lets any agent — and its
        human — see its own environment: every connected server, every tool and its
        declared annotations, the negotiated capabilities, the context window, and
        the wire. One tool. The whole board.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href="#quickstart">Connect in 60 seconds</a>
        <a class="btn btn-ghost" href="/learn">Read the Learn library</a>
      </div>
      <p class="muted small hero-foot">
        <span class="verified" aria-hidden="true">✓</span>
        Snapshots are analyzed in memory and <strong>never persisted</strong>.
      </p>
    </div>
  </section>

  <!-- Live demo -->
  <section class="demo" aria-labelledby="demo-heading">
    <div class="wrap">
      <p class="eyebrow">See the rectangle before you connect</p>
      <h2 id="demo-heading">The App, live in demo mode</h2>
      <p>
        This is the actual <a href="/learn/what-is-an-mcp-app">MCP App</a> view
        mcp-glimpse renders inside a host — running here in demo mode with sample
        data. It's one self-contained HTML file that makes no external requests.
      </p>
      <div class="demo-frame panel">
        <iframe
          src="/app-demo.html?demo=1"
          title="mcp-glimpse App — interactive demo of an agent introspection report"
          loading="lazy"
          referrerpolicy="no-referrer"
        ></iframe>
      </div>
      <p class="muted small">
        Prefer full screen?
        <a href="/app-demo.html?demo=1" target="_blank" rel="noopener">Open the demo in a new tab</a>.
      </p>
    </div>
  </section>

  <!-- Quickstart -->
  <section id="quickstart" class="quickstart" aria-labelledby="qs-heading">
    <div class="wrap">
      <p class="eyebrow">60-second quickstart</p>
      <h2 id="qs-heading">Connect, then introspect</h2>
      <div class="qs-grid">
        <div class="qs-step panel">
          <p class="qs-num">1</p>
          <h3>Add the hosted server</h3>
          <p class="muted small">Streamable HTTP — add it as a connector in your MCP host.</p>
          <pre class="code" tabindex="0"><code>{SITE.mcpEndpoint}</code></pre>
        </div>
        <div class="qs-step panel">
          <p class="qs-num">2</p>
          <h3>Or run it locally</h3>
          <p class="muted small">Over stdio, for any local MCP host. Same server object.</p>
          <pre class="code" tabindex="0"><code>uvx {SITE.pypiPackage}</code></pre>
        </div>
        <div class="qs-step panel">
          <p class="qs-num">3</p>
          <h3>Run the tool</h3>
          <p class="muted small">Give it a snapshot of everything you can see.</p>
          <pre class="code" tabindex="0"><code>{SITE.primaryTool}</code></pre>
        </div>
      </div>
      <p class="muted small">
        Call <code>{SITE.primaryTool}</code> with a full snapshot for the panoramic
        view across every server, or with no argument for the server-only slice —
        the contrast is the point.
      </p>
    </div>
  </section>

  <!-- Capability matrix -->
  <section class="matrix" aria-labelledby="matrix-heading">
    <div class="wrap">
      <p class="eyebrow">Every MCP primitive, demonstrated live</p>
      <h2 id="matrix-heading">Capability matrix</h2>
      <p>
        mcp-glimpse doesn't just <em>report</em> MCP capabilities — it exercises
        them, so you can watch each one work. Interactive capabilities need a
        <a href="/learn/stateless-vs-stateful-transports">stateful session</a>;
        mcp-glimpse runs one.
      </p>
      <div class="data-table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">Declared by</th>
              <th scope="col">In mcp-glimpse</th>
              <th scope="col">How it's used</th>
            </tr>
          </thead>
          <tbody>
            {
              capabilities.map((c) => (
                <tr>
                  <th scope="row">{c.name}</th>
                  <td>{c.who}</td>
                  <td><span class="verified" aria-hidden="true">✓</span> <span class="visually-hidden">Yes — </span>{c.glimpse}</td>
                  <td class="muted">{c.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Learn preview -->
  <section class="learn-preview" aria-labelledby="learn-heading">
    <div class="wrap">
      <p class="eyebrow">Answer-shaped explainers</p>
      <h2 id="learn-heading">Learn</h2>
      <p>
        A small library of genuinely good MCP explainers — each a question with a
        direct answer, then the depth.
      </p>
      <ul class="learn-list">
        {
          learn.slice(0, 6).map((a) => (
            <li>
              <a href={`/learn/${a.id}`}>
                <span class="learn-q">{a.data.title}</span>
                <span class="learn-a muted">{a.data.answer}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p><a href="/learn">All {learn.length} articles →</a></p>
    </div>
  </section>

  <!-- Privacy note -->
  <section class="privacy-note" aria-labelledby="priv-heading">
    <div class="wrap">
      <p class="eyebrow">Honest by design</p>
      <h2 id="priv-heading">What we do and don't keep</h2>
      <p>
        The snapshot you introspect is analyzed <strong>in memory and never
        stored</strong>. There's no snapshot logging. The only writes that ever
        happen are the ones you explicitly make — submitting feedback, or choosing
        to publish an anonymized share card — and each is confirmed before anything
        is persisted.
      </p>
      <p><a href="/privacy">Read the full privacy note →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <ConnectCTA heading="Ready? Point your agent at itself." />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 6rem) clamp(2.5rem, 6vw, 4rem);
  }
  .hero-title {
    font-size: clamp(2.8rem, 9vw, 5.5rem);
    line-height: 0.98;
    margin-bottom: 1.2rem;
  }
  .hero-lede {
    max-width: 46ch;
    margin-bottom: 0.5rem;
  }
  .hero-foot {
    margin-top: 1.6rem;
    margin-bottom: 0;
  }

  .demo-frame {
    padding: 0;
    overflow: hidden;
    margin-top: 1.5rem;
    background: var(--color-surface);
  }
  .demo-frame iframe {
    display: block;
    width: 100%;
    height: min(78vh, 760px);
    border: 0;
  }

  .qs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin: 1.5rem 0 1rem;
  }
  @media (max-width: 720px) {
    .qs-grid {
      grid-template-columns: 1fr;
    }
  }
  .qs-step {
    display: flex;
    flex-direction: column;
  }
  .qs-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    width: 1.7rem;
    height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    margin: 0 0 0.75rem;
  }
  .qs-step h3 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0;
    margin-bottom: 0.35rem;
  }
  .qs-step p {
    margin-bottom: 0.75rem;
  }
  .qs-step pre.code {
    margin-top: auto;
    margin-bottom: 0;
  }

  .learn-list {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }
  .learn-list li {
    border-bottom: 1px solid var(--color-border);
  }
  .learn-list a {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0;
    text-decoration: none;
    color: var(--color-foreground);
  }
  .learn-q {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.2;
  }
  .learn-list a:hover .learn-q {
    color: var(--color-accent);
  }
  .learn-a {
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 75ch;
  }
</style>
