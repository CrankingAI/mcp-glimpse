{
  "$schema": "https://tr.designtokens.org/format/tokens.schema.json",
  "$description": "Paper & Proof — the EffAz fleet design system, v1 (2026-07-07). Fleet default; override per repo via DESIGN.md + design-consultation. Light 'Paper' is the default theme; the 'dark' group re-derives the same semantic names for the 'Bench' theme and is emitted as a [data-theme=dark] override block by build.mjs.",
  "color": {
    "$type": "color",
    "paper": {
      "$description": "Warm paper neutrals — the light-mode ground. Never pure gray.",
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#FBFAF6" },
      "100": { "$value": "#F6F4EE", "$description": "Default page background." },
      "200": { "$value": "#EFECE2" },
      "300": { "$value": "#E4E0D5", "$description": "Hairline rules — 1px, the only structure." },
      "400": { "$value": "#CFCABC" }
    },
    "ink": {
      "$description": "Warm ink — never #000.",
      "900": { "$value": "#1C1A16", "$description": "Primary text and primary buttons." },
      "700": { "$value": "#403C33" },
      "500": { "$value": "#6B665B", "$description": "Muted text — AA on paper.100." },
      "400": { "$value": "#8A8478" }
    },
    "bench": {
      "$description": "Warm dark neutrals — the 'Bench' dark theme. Warm, not blue.",
      "900": { "$value": "#14130F", "$description": "Dark page background." },
      "800": { "$value": "#1D1B16", "$description": "Dark surface." },
      "700": { "$value": "#2A2822", "$description": "Dark hairline." },
      "600": { "$value": "#3A372F" },
      "200": { "$value": "#9A948A", "$description": "Dark muted text." },
      "50": { "$value": "#ECE8DD", "$description": "Dark primary text." }
    },
    "green": {
      "$description": "Gate green — the one accent. It appears only where something is true: links, active states, verified marks. More than three green elements in a viewport is a failed design.",
      "100": { "$value": "#E7F0EB", "$description": "Whisper wash — selected rows, badges (light)." },
      "300": { "$value": "#7AD8AF" },
      "400": { "$value": "#4CC38F", "$description": "Accent on dark — AA on bench.900." },
      "600": { "$value": "#16694B", "$description": "Accent on light — AA on paper.100." },
      "700": { "$value": "#0F4D37", "$description": "Pressed / high-contrast." },
      "950": { "$value": "#1B2A23", "$description": "Whisper wash (dark)." }
    },
    "amber": {
      "$description": "Warning family.",
      "100": { "$value": "#F5EAD4" },
      "400": { "$value": "#D9A13B" },
      "600": { "$value": "#8A5A00" },
      "950": { "$value": "#2B2415" }
    },
    "red": {
      "$description": "Danger family — warm red, clearly not the accent.",
      "100": { "$value": "#F5E2E0" },
      "400": { "$value": "#E0685E" },
      "600": { "$value": "#A83A32" },
      "950": { "$value": "#2E1B19" }
    },
    "slate": {
      "$description": "Info family — recessive blue-gray, never brand blue.",
      "100": { "$value": "#E6ECF1" },
      "400": { "$value": "#8FAFC5" },
      "600": { "$value": "#4A6478" },
      "950": { "$value": "#1B242B" }
    },
    "background": { "$value": "{color.paper.100}", "$description": "Semantic: page ground." },
    "surface": { "$value": "{color.paper.0}", "$description": "Semantic: cards/panels, bounded by hairlines not shadows." },
    "foreground": { "$value": "{color.ink.900}", "$description": "Semantic: primary text." },
    "muted": { "$value": "{color.ink.500}", "$description": "Semantic: secondary text." },
    "border": { "$value": "{color.paper.300}", "$description": "Semantic: hairline rules." },
    "border-strong": { "$value": "{color.paper.400}", "$description": "Semantic: input borders, emphasized rules." },
    "primary": { "$value": "{color.ink.900}", "$description": "Semantic: primary action (ink buttons — green is NOT the button color)." },
    "primary-foreground": { "$value": "{color.paper.100}", "$description": "Semantic: text on primary." },
    "accent": { "$value": "{color.green.600}", "$description": "Semantic: gate green — links, active, verified, focus ring." },
    "accent-strong": { "$value": "{color.green.700}", "$description": "Semantic: accent pressed/hover." },
    "accent-wash": { "$value": "{color.green.100}", "$description": "Semantic: accent at whisper volume." },
    "ring": { "$value": "{color.green.600}", "$description": "Semantic: focus ring — verification green." },
    "success": { "$value": "{color.green.600}" },
    "success-wash": { "$value": "{color.green.100}" },
    "warning": { "$value": "{color.amber.600}" },
    "warning-wash": { "$value": "{color.amber.100}" },
    "danger": { "$value": "{color.red.600}", "$description": "Semantic: shadcn --destructive maps here." },
    "danger-wash": { "$value": "{color.red.100}" },
    "info": { "$value": "{color.slate.600}" },
    "info-wash": { "$value": "{color.slate.100}" }
  },
  "dark": {
    "$description": "The 'Bench' theme: same semantic names re-derived for dark. Emitted as a [data-theme=dark] override block — see build.mjs.",
    "color": {
      "$type": "color",
      "background": { "$value": "{color.bench.900}" },
      "surface": { "$value": "{color.bench.800}" },
      "foreground": { "$value": "{color.bench.50}" },
      "muted": { "$value": "{color.bench.200}" },
      "border": { "$value": "{color.bench.700}" },
      "border-strong": { "$value": "{color.bench.600}" },
      "primary": { "$value": "{color.bench.50}", "$description": "Dark primary button: light ink." },
      "primary-foreground": { "$value": "{color.bench.900}" },
      "accent": { "$value": "{color.green.400}" },
      "accent-strong": { "$value": "{color.green.300}" },
      "accent-wash": { "$value": "{color.green.950}" },
      "ring": { "$value": "{color.green.400}" },
      "success": { "$value": "{color.green.400}" },
      "success-wash": { "$value": "{color.green.950}" },
      "warning": { "$value": "{color.amber.400}" },
      "warning-wash": { "$value": "{color.amber.950}" },
      "danger": { "$value": "{color.red.400}" },
      "danger-wash": { "$value": "{color.red.950}" },
      "info": { "$value": "{color.slate.400}" },
      "info-wash": { "$value": "{color.slate.950}" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "serif": {
      "$value": ["Instrument Serif", "Georgia", "serif"],
      "$description": "Display voice — headings and pull moments ONLY, never paragraphs. The serif is a risk; ration it like the green."
    },
    "sans": {
      "$value": ["Instrument Sans", "system-ui", "sans-serif"],
      "$description": "Body and UI — quietly excellent embodied. Does all the work without being noticed."
    },
    "mono": {
      "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
      "$description": "Machine facts: code, IDs, latencies, tabular data, plate captions, eyebrow labels."
    }
  },
  "spacing": {
    "$type": "dimension",
    "$value": { "value": 4, "unit": "px" },
    "$description": "Tailwind v4 base multiplier — the 4px rhythm. Comfortable density."
  },
  "radius": {
    "$type": "dimension",
    "$description": "Square-leaning, serious. Deliberately overrides Tailwind's rounded-* scale.",
    "sm": { "$value": { "value": 2, "unit": "px" } },
    "md": { "$value": { "value": 4, "unit": "px" } },
    "lg": { "$value": { "value": 8, "unit": "px" } },
    "xl": { "$value": { "value": 12, "unit": "px" } },
    "full": { "$value": { "value": 9999, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "overlay": {
      "$value": {
        "color": "#1C1A1626",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 16, "unit": "px" },
        "spread": { "value": -2, "unit": "px" }
      },
      "$description": "The ONLY shadow — floating layers (menus, popovers, dialogs). Structure is hairlines; shadows are not decoration."
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "feel.md motion scale. State feedback ~100-200ms; spatial change ~200-400ms.",
    "micro": { "$value": { "value": 100, "unit": "ms" } },
    "short": { "$value": { "value": 200, "unit": "ms" } },
    "medium": { "$value": { "value": 320, "unit": "ms" } },
    "long": { "$value": { "value": 480, "unit": "ms" } }
  },
  "ease": {
    "$type": "cubicBezier",
    "enter": { "$value": [0.16, 1, 0.3, 1], "$description": "Entrances decelerate." },
    "exit": { "$value": [0.7, 0, 0.84, 0], "$description": "Exits accelerate." },
    "move": { "$value": [0.45, 0, 0.15, 1], "$description": "Spatial moves ease both ends." }
  }
}
